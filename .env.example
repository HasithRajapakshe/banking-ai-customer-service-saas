# ==========================================
# Application
# ==========================================

APP_NAME=banking-ai-customer-service-saas
APP_ENV=development
DEBUG=true

# ==========================================
# PostgreSQL
# ==========================================

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=banking_ai
POSTGRES_USER=banking_app
POSTGRES_PASSWORD=change_me

DATABASE_URL=postgresql+asyncpg://banking_app:change_me@localhost:5432/banking_ai

# ==========================================
# Redis
# ==========================================

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# ==========================================
# AI Model Provider
# ==========================================

LLM_PROVIDER=mock

# These remain empty during initial development
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# ==========================================
# RAG
# ==========================================

VECTOR_DATABASE=pgvector
EMBEDDING_PROVIDER=mock

# ==========================================
# Security
# ==========================================

JWT_SECRET=change_me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# ==========================================
# Synthetic Bank
# ==========================================

SYNTHETIC_BANK_URL=http://synthetic-bank:8001

# ==========================================
# Application Services
# ==========================================

BACKEND_URL=http://backend:8000

INTERNAL_API_KEY=replace-with-secure-internal-api-key