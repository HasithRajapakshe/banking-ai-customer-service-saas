# ==========================================
# Application
# ==========================================

APP_NAME=banking-ai-customer-service-saas
APP_ENV=development
DEBUG=true

# ==========================================
# PostgreSQL
# ==========================================

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=banking_ai
POSTGRES_USER=banking_app
POSTGRES_PASSWORD=change_me_in_production

DATABASE_URL=postgresql+asyncpg://banking_app:change_me_in_production@postgres:5432/banking_ai
DATABASE_URL_SYNC=postgresql://banking_app:change_me_in_production@postgres:5432/banking_ai

# ==========================================
# Redis
# ==========================================

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# ==========================================
# AI Model Provider (ai-agent model gateway)
# ==========================================
# MODEL_PROVIDER: ollama | gemini | openai | anthropic | deterministic
#   deterministic = keyword router only, no LLM (what CI uses).
# If the provider is unreachable or misconfigured, the agent logs the error
# and falls back to the keyword router.

MODEL_PROVIDER=ollama
MODEL_NAME=qwen2.5:7b
# Ollama running on the host machine (https://ollama.com):
OLLAMA_BASE_URL=http://host.docker.internal:11434
LLM_TIMEOUT_SECONDS=60

# Examples:
# MODEL_PROVIDER=gemini     MODEL_NAME=gemini-2.0-flash   (needs GOOGLE_API_KEY)
# MODEL_PROVIDER=openai     MODEL_NAME=gpt-4o-mini        (needs OPENAI_API_KEY)
# MODEL_PROVIDER=anthropic  MODEL_NAME=claude-haiku-5-5   (needs ANTHROPIC_API_KEY)
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ==========================================
# RAG / Embeddings
# ==========================================

VECTOR_DATABASE=pgvector
# mock = deterministic offline embeddings (default). openai requires a real
# OPENAI_API_KEY; an empty/placeholder key falls back to mock with a warning.
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=text-embedding-3-small

# ==========================================
# Security / JWT
# ==========================================

JWT_SECRET=change-this-to-a-long-random-secret-in-production
# Service-to-service identity token (api-gateway signs; tool-gateway and rag
# verify). Must differ from JWT_SECRET. Tokens live 60 seconds.
INTERNAL_JWT_SECRET=change-this-internal-service-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ==========================================
# Internal Service API Keys
# ==========================================

SYNTHETIC_BANK_API_KEY=synthetic-bank-internal-key-dev
BANKING_ADAPTER_API_KEY=banking-adapter-internal-key-dev
TOOL_GATEWAY_API_KEY=tool-gateway-internal-key-dev

# ==========================================
# Tenant Configuration
# ==========================================

TENANT_ID=f498100f-80c4-467e-84ec-ebfe5470b442
BANK_CODE=SLBANK01

# ==========================================
# Service URLs (Docker internal)
# ==========================================

SYNTHETIC_BANK_BASE_URL=http://synthetic-bank:8000
BANKING_ADAPTER_BASE_URL=http://banking-adapter:8002
TOOL_GATEWAY_BASE_URL=http://tool-gateway:8003
AI_AGENT_BASE_URL=http://ai-agent:8004
RAG_BASE_URL=http://rag:8005
API_GATEWAY_BASE_URL=http://api-gateway:8001