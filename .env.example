# ==========================================
# Application
# ==========================================

APP_NAME=banking-ai-customer-service-saas
APP_ENV=development
DEBUG=true

# ==========================================
# PostgreSQL
# ==========================================

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=banking_ai
POSTGRES_USER=banking_app
POSTGRES_PASSWORD=change_me_in_production

DATABASE_URL=postgresql+asyncpg://banking_app:change_me_in_production@postgres:5432/banking_ai
DATABASE_URL_SYNC=postgresql://banking_app:change_me_in_production@postgres:5432/banking_ai

# ==========================================
# Redis
# ==========================================

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# ==========================================
# AI Model Provider
# ==========================================

LLM_PROVIDER=deterministic
LLM_MODEL=deterministic-v1

# Set these when using a real LLM:
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# ==========================================
# RAG / Embeddings
# ==========================================

VECTOR_DATABASE=pgvector
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=text-embedding-3-small

# ==========================================
# Security / JWT
# ==========================================

JWT_SECRET=change-this-to-a-long-random-secret-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ==========================================
# Internal Service API Keys
# ==========================================

SYNTHETIC_BANK_API_KEY=synthetic-bank-internal-key-dev
BANKING_ADAPTER_API_KEY=banking-adapter-internal-key-dev
TOOL_GATEWAY_API_KEY=tool-gateway-internal-key-dev

# ==========================================
# Tenant Configuration
# ==========================================

TENANT_ID=f498100f-80c4-467e-84ec-ebfe5470b442
BANK_CODE=SLBANK01

# ==========================================
# Service URLs (Docker internal)
# ==========================================

SYNTHETIC_BANK_BASE_URL=http://synthetic-bank:8000
BANKING_ADAPTER_BASE_URL=http://banking-adapter:8002
TOOL_GATEWAY_BASE_URL=http://tool-gateway:8003
AI_AGENT_BASE_URL=http://ai-agent:8004
RAG_BASE_URL=http://rag:8005
API_GATEWAY_BASE_URL=http://api-gateway:8001