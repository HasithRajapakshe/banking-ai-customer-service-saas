              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Payment Reference"
        },
        "idempotency_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Idempotency Key"
        }
      },
      "required": [
        "source_account_id",
        "beneficiary_id",
        "amount",
        "currency"
      ],
      "title": "PaymentCreateInput",
      "type": "object"
